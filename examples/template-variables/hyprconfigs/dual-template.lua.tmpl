-- Dual monitor template with different scaling per monitor
{{- range .Monitors }}
{{- if eq .Tag "laptop" }}
hl.monitor({ output = "{{ .Name }}", mode = "1920x1080@{{ $.refresh_rate_ac }}", position = "0x0", scale = {{ $.default_scaling }} })
{{- else if eq .Tag "external" }}
hl.monitor({ output = "{{ .Name }}", mode = "1920x1080@60", position = "1080x0", scale = {{ $.external_scaling }} })
{{- end }}
{{- end }}

-- Workspace layout based on template variable
{{- if eq .workspace_layout "extended" }}
hl.workspace_rule({ workspace = "1", monitor = "eDP-1" })
hl.workspace_rule({ workspace = "2", monitor = "DP-11" })
{{- end }}
